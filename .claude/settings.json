{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": ["-NoProfile", "-NonInteractive", "-File", "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-git-write.ps1"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
